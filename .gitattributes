# Todo lo que se copia al servidor Linux tiene que quedar con finales de línea
# LF: un script con CRLF falla con "bad interpreter".
*.sh          text eol=lf
*.conf        text eol=lf
*.service     text eol=lf
*.timer       text eol=lf
deploy/guia-jc-backup   text eol=lf
deploy/user-data.sh     text eol=lf
